# Dockerfile.api
# Runs the x402 verification service with tsx against the workspace packages.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/engine/package.json packages/engine/
COPY packages/fixtures/package.json packages/fixtures/
COPY services/verify-api/package.json services/verify-api/
RUN npm ci
COPY packages/engine packages/engine
COPY services/verify-api services/verify-api
COPY tsconfig.base.json ./
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
CMD ["npx", "tsx", "services/verify-api/src/server.ts"]

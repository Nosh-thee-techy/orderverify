# verify-api reads the repo-root .env. This file documents the variables that belong to the service.
# See the root .env.example for the full list.

PORT=4021
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
OZ_API_KEY=
SERVICE_RECIPIENT=
STELLAR_NETWORK=stellar:testnet
PRICE_USD=0.01
MAX_ORDERS_PER_BATCH=50
# live | bypass. Bypass is refused when NODE_ENV=production.
X402_MODE=live

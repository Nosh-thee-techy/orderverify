# Web app. Copy the repo-root .env.example to the repo root. This process reads that file.

DATABASE_URL=postgres://orderverify:orderverify@localhost:5433/orderverify
VERIFY_API_URL=http://localhost:4021
AGENT_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# live | bypass. Bypass is ignored when NODE_ENV=production and shows a red banner in dev.
X402_MODE=live
DEFAULT_WEEKLY_CAP_KES=50
KES_PER_USD=129
PRICE_USD=0.01
STELLAR_NETWORK=stellar:testnet
PHONE_HASH_SALT=dev-only-change-me
RETENTION_DAYS=7
# Server only. Used to email a finished batch report. Ignored in the browser.
RESEND_API_KEY=
EMAIL_FROM=

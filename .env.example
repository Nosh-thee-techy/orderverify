# Shared OrderVerify environment. Copy to .env at the repo root.
# apps/web and services/verify-api also read this file (and their own .env).

# ---- shared ----
# Stellar network id used by the x402 exact scheme. Demo uses testnet only.
STELLAR_NETWORK=stellar:testnet
# Price charged for one verification batch, in US dollars. The facilitator converts this to USDC.
PRICE_USD=0.01
# Batches larger than this are rejected with HTTP 413. The web app splits them.
MAX_ORDERS_PER_BATCH=50
# Display-only KES conversion. Approximate, and intentionally configurable.
KES_PER_USD=129

# ---- verify-api ----
PORT=4021
# OpenZeppelin Channels x402 facilitator (Stellar testnet).
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# Bearer token from https://channels.openzeppelin.com/testnet/gen
OZ_API_KEY=
# Classic G... account that RECEIVES the USDC. Needs a USDC trustline.
SERVICE_RECIPIENT=

# ---- web ----
# Local Docker default. Replace with Neon or Supabase in production.
DATABASE_URL=postgres://orderverify:orderverify@localhost:5433/orderverify
VERIFY_API_URL=http://localhost:4021
# Payer secret (S...). Server only. Never import this from a client component.
AGENT_SECRET=
# Optional. When empty, order extraction uses the deterministic regex fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# live | bypass. bypass is ignored when NODE_ENV=production.
X402_MODE=live
# Weekly spending cap for a new demo seller, in Kenyan shillings.
DEFAULT_WEEKLY_CAP_KES=50
# Salt for phone-number hashes. Change this before any real deployment.
PHONE_HASH_SALT=dev-only-change-me
# How long raw chat excerpts are kept before the cleanup script blanks them.
RETENTION_DAYS=7
# Resend (server only). Leave empty locally if you are not sending report emails.
RESEND_API_KEY=
# Verified Resend from-address, e.g. OrderVerify <beth.t@example.com>
EMAIL_FROM=
